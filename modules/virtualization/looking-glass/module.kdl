description "Looking Glass: the kvmfr DKMS kernel module and the client, for frame relay from a passed-through GPU"

supports "fedora"

requires "kernel-devel"
requires-file "/usr/share/secureboot/sb_cert.der"
requires-file "/usr/libexec/kernel-devel-helpers.sh"

provides-file "/usr/bin/looking-glass-client"

arg "KERNEL"
secret "mok_privkey"

asset "looking-glass" {
    renovate datasource="github-releases" depName="gnif/LookingGlass"
    version "B7"
}
