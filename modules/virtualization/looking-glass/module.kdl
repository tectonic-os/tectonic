description "kvmfr DKMS kernel module, for Looking Glass frame relay from a passed-through GPU"

supports "fedora"

requires "kernel-devel"
requires-file "/usr/share/secureboot/sb_cert.der"
requires-file "/usr/libexec/kernel-devel-helpers.sh"

arg "KERNEL"
secret "mok_privkey"

asset "looking-glass" {
    renovate datasource="github-releases" depName="gnif/LookingGlass"
    version "B7"
}
