description "libvirt, QEMU/KVM and virt-manager, with the group and relabel workarounds they need"

supports "fedora"

packages {
    fedora "edk2-ovmf" "libvirt" "libvirt-nss" "qemu" "qemu-img" \
            "qemu-system-x86-core" "qemu-user-binfmt" "qemu-user-static-aarch64" \
            "virt-manager" "virt-v2v" "virt-viewer"
}

after "hardened-malloc"
