# vim: set ft=make :
# System justfile behind the os-name alias (etc/profile.d/goojust.sh).
# This is goojust's default --justfile path, so the alias needs no flag.
# Ships in the image so recipes are always current; personal additions go
# in ~/.config/just/user.justfile via the import at the bottom.
# Comments above recipes provide the description for goojust.
#
# Recipes that need runtime UI interactions (progress, confirm, prompt)
# source /usr/share/goojust/goojust-helpers.sh which provides progNew,
# progUpdate, progClear, prompt, choose, confirm, and summary functions
# that emit OSC 9 sequences handled by goojust's TUI.
set allow-duplicate-recipes := true
set ignore-comments := true

_default:
	@just --justfile '{{ justfile() }}' --list --list-heading $'Available commands:\n' --list-prefix $' - '

import? "/usr/share/goojust/justfile.apps"

import? "~/.config/just/user.justfile"
