{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
  ],

  // The pull request title check requires a typed subject, and Renovate
  // otherwise guesses the commit style from the history.
  "semanticCommits": "enabled",
  "rebaseWhen": "never",
  "timezone": "Etc/UTC",
  "schedule": ["before 6am"],

  "packageRules": [
    {
      "matchPackageNames": ["*"],
      "groupName": "scheduled updates",
      "automerge": true,
    },
  ],
}
