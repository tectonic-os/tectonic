base "quay.io/fedora/fedora-bootc:44" {
    about "Fedora 44, as this collection describes it"
    family "fedora"
    provides "rechunking" "initramfs-generation" "selinux-policy"
    signed #true
    bootloader "grub2"
}

base "example.invalid/collected:1" {
    about "A base only the collection knows about"
    family "fedora"
    provides "rechunking" "collected"
    bootloader "grub2"
}
