schema-version 1

image {
    name "Broken network"

    base-image {
        fedora-bootc-44
    }

    layout {
        bootloader "grub2"
    }

    fedora-family
    core {
        tools
    }
    core {
        fetcher
    }
    core {
        asset-only
    }
    core {
        fragment-only
    }
    core {
        installer
    }
}
