schema-version 1

image {
    name "Example"
    url "https://github.com/someone/example"
    issues-url "https://github.com/someone/example/issues"

    base-image {
        fedora-bootc-44
    }

    flavours {
        nvidia
    }

    fedora-family
    hello
    flatpak variant="beta" {
        system-wide #false
    }
    flavour "nvidia" {
        drivers
    }
}
