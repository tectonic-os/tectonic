schema-version 1

image {
    name "Refused"
    conforms "standard"

    base-image {
        fedora-bootc-44
    }

    // A component's refusal is its judgement about a deployment, and this image
    // overrides one of them and names a rule nothing refuses.
    allow-remediation "sshd_disable_root_login" because="this image is reached over ssh as root"
    allow-remediation "no_component_here_refuses_this" because="and so it lifts nothing"

    one {
        contradicts
    }
    one {
        typo
    }
}
