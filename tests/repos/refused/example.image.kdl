image {
    name "Refused"
    conforms "standard"

    base "quay.io/fedora/fedora-bootc:44" {
        family "fedora"
        provides "rechunking"

        // A base claims the way a module does, so remediation has to leave
        // this alone too.
        satisfies {
            stig "RHEL-09-232010"
        }
    }

    modules {
        module "one/contradicts"
        module "one/typo"
    }
}
