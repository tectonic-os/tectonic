description "Every way a key declaration can be wrong"

supports "fedora"

key "cosign" when="published" {
    generator "ssh-keygen"
    public "etc/pki/containers/cosign.pub" format="jwk"
    private "keys/cosign.key"
}

key "secureboot" {
    generator "openssl" profile="signing" bits=1
    public "/usr/share/secureboot/sb_cert.der" encoding="der"
    private ".hidden"
    passphrase "hunter2"
}

key "secureboot" {
    generator "openssl"
    public "/usr/share/secureboot/sb_cert.der"
    private "MOK.priv"
}

key
