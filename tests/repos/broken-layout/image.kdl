image {
    name "Sealed"

    base "docker.io/library/debian:forky" {
        family "debian"
    }

    // xfs has no fs-verity and the debian install seals the deployment. The
    // schema holds no `subvolumes`, `pool` or `var-disk`, so each one is refused.
    layout {
        filesystem "xfs" subvolumes=#true pool="rpool"
        var-disk "sdb"
    }

    modules {}
}

image {
    name "Halfway"

    // Half an answer on a family nothing here has measured, which is the one
    // state that would reach `bootc install` on a default nobody chose.
    base "ghcr.io/someone/arch-bootc:latest" {
        family "arch"
    }

    layout {
        filesystem "zfs"
        composefs #true
    }

    modules {}
}
