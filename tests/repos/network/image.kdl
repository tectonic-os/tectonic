image {
    name "Network"

    base "quay.io/fedora/fedora-bootc:44" {
        family "fedora"
        provides "rechunking" "selinux-policy"
    }

    layout {
        bootloader "grub2"
    }

    modules {
        module "fedora-family"
        module "core/tools"
        module "core/fetcher"
        module "core/quiet"
        module "core/spliced"
    }
}
