image {
    name "Suppressed"

    base "ghcr.io/ublue-os/bazzite:stable" {
        family "fedora"
        provides "rechunking" "flatpak"
        satisfies {
            cis-fedora "1.1.1.1" "4.1.3.1"
        }
    }

    modules {
        module "apps/flatpak" variant="beta" {
            system-wide #false
        }
        module "apps/browser"
    }
}
