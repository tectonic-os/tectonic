image {
    name "Workstation"

    base "quay.io/fedora/fedora-bootc:44" {
        family "fedora"
        provides "rechunking"
    }

    flavours {
        base default=#true
        dev
    }

    modules {
        module "core/shared"

        flavour "dev" {
            module "core/dev-tools"
        }
    }
}
