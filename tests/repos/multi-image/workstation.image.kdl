schema-version 1

image {
    name "Workstation"
    conforms "standard"

    base-image {
        fedora-bootc-44
    }

    flavours {
        base default=#true
        dev conforms="cusp_fedora"
    }

    core {
        shared
    }

    flavour "dev" {
        core {
            dev-tools
        }
    }
}
