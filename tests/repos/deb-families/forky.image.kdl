image {
    name "Forky"

    base "docker.io/library/debian:forky" {
        family "debian"
        requires "bootc-base"
    }

    layout {
        bootloader "grub2"
    }

    modules {
        module "debian-family"
        module "core/bootc-base"
        module "core/confined"
        module "core/menu"
        module "core/shared"
    }
}
