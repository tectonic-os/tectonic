schema-version 1

image {
    name "Arch"

    // A family nothing here has measured. The image answers for itself, so it
    // installs; an image on this base declaring no layout builds no media.
    base-image {
        arch-bootc-latest
    }

    layout {
        filesystem "btrfs"
        composefs #true
        generic-image #true
        admin-group "wheel"
        bootloader "systemd"
    }

}
