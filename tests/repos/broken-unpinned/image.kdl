image {
    name "Broken Unpinned"

    base "quay.io/fedora/fedora-bootc:44" {
        family "fedora"
        provides "rechunking"
    }

    modules {
        module "loose" {
            pin {
                unpinned "trusted"
                version "main"
                url "https://github.com/owner/modules/archive/refs/heads/{version}.tar.gz"
            }
        }
    }
}
