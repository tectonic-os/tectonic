image {
    name "Broken Unpinned"

    base "quay.io/fedora/fedora-bootc:44" {
        family "fedora"
        provides "rechunking"
    }

    modules {
        module "loose" {
            source "https://github.com/owner/modules/archive/refs/heads/{ref}.tar.gz" {
                unpinned "trusted"
                ref "main"
            }
        }
    }
}
