---
source: tests/golden/harness.rs
---
### Base Image
FROM ${BASE} AS rootfs

## Component layers

# ---- /opt build root ----
RUN mv /opt /opt.bak && mkdir /opt

# ---- /usr/local build root ----
RUN if [ -L /usr/local ]; then mv /usr/local /usr/local.bak && \
    mkdir -p /usr/local/bin /usr/local/etc /usr/local/games /usr/local/include \
    /usr/local/lib /usr/local/lib64 /usr/local/libexec /usr/local/share /usr/local/src; fi

# ---- fedora-family ----
RUN --network=none --mount=type=bind,from=ctx,source=/components/fedora-family,target=/ctx/components/fedora-family \
    --mount=type=bind,from=ctx,source=/generated/lib,target=/ctx/lib,rw \
    --mount=type=bind,from=ctx,source=/components/fedora-family/lib/family.sh,target=/ctx/lib/family.sh \
    --mount=type=bind,from=ctx,source=/generated/network/components/fedora-family.sh,target=/ctx/component.sh \
    --mount=type=bind,from=tect,source=/tect,target=/ctx/tect \
    --mount=type=cache,target=/var/cache \
    --mount=type=cache,target=/var/log \
    --mount=type=tmpfs,target=/tmp \
    bash /ctx/component.sh

# ---- core/tools ----
RUN --mount=type=bind,from=ctx,source=/components/core/tools,target=/ctx/components/core/tools \
    --mount=type=bind,from=ctx,source=/generated/lib,target=/ctx/lib,rw \
    --mount=type=bind,from=ctx,source=/components/fedora-family/lib/family.sh,target=/ctx/lib/family.sh \
    --mount=type=bind,from=ctx,source=/generated/network/packages/core/tools.sh,target=/ctx/component.sh \
    --mount=type=bind,from=tect,source=/tect,target=/ctx/tect \
    --mount=type=cache,target=/var/cache \
    --mount=type=cache,target=/var/log \
    --mount=type=tmpfs,target=/tmp \
    bash /ctx/component.sh

RUN --network=none --mount=type=bind,from=ctx,source=/components/core/tools,target=/ctx/components/core/tools \
    --mount=type=bind,from=ctx,source=/generated/lib,target=/ctx/lib,rw \
    --mount=type=bind,from=ctx,source=/components/fedora-family/lib/family.sh,target=/ctx/lib/family.sh \
    --mount=type=bind,from=ctx,source=/generated/network/components/core/tools.sh,target=/ctx/component.sh \
    --mount=type=bind,from=tect,source=/tect,target=/ctx/tect \
    --mount=type=cache,target=/var/cache \
    --mount=type=cache,target=/var/log \
    --mount=type=tmpfs,target=/tmp \
    bash /ctx/component.sh

# ---- core/fetcher ----
RUN --mount=type=bind,from=ctx,source=/components/core/fetcher,target=/ctx/components/core/fetcher \
    --mount=type=bind,from=ctx,source=/generated/lib,target=/ctx/lib,rw \
    --mount=type=bind,from=ctx,source=/components/fedora-family/lib/family.sh,target=/ctx/lib/family.sh \
    --mount=type=bind,from=ctx,source=/generated/network/components/core/fetcher.sh,target=/ctx/component.sh \
    --mount=type=bind,from=tect,source=/tect,target=/ctx/tect \
    --mount=type=cache,target=/var/cache \
    --mount=type=cache,target=/var/log \
    --mount=type=tmpfs,target=/tmp \
    bash /ctx/component.sh

# ---- core/quiet ----
RUN --network=none --mount=type=bind,from=ctx,source=/components/core/quiet,target=/ctx/components/core/quiet \
    --mount=type=bind,from=ctx,source=/generated/lib,target=/ctx/lib,rw \
    --mount=type=bind,from=ctx,source=/components/fedora-family/lib/family.sh,target=/ctx/lib/family.sh \
    --mount=type=bind,from=ctx,source=/generated/network/components/core/quiet.sh,target=/ctx/component.sh \
    --mount=type=bind,from=tect,source=/tect,target=/ctx/tect \
    --mount=type=cache,target=/var/cache \
    --mount=type=cache,target=/var/log \
    --mount=type=tmpfs,target=/tmp \
    bash /ctx/component.sh

# ---- core/spliced ----
# verbatim from components/core/spliced/Containerfile.inc:
RUN true

RUN --network=none --mount=type=bind,from=ctx,source=/components/core/spliced,target=/ctx/components/core/spliced \
    --mount=type=bind,from=ctx,source=/generated/lib,target=/ctx/lib,rw \
    --mount=type=bind,from=ctx,source=/components/fedora-family/lib/family.sh,target=/ctx/lib/family.sh \
    --mount=type=bind,from=ctx,source=/generated/network/components/core/spliced.sh,target=/ctx/component.sh \
    --mount=type=bind,from=tect,source=/tect,target=/ctx/tect \
    --mount=type=cache,target=/var/cache \
    --mount=type=cache,target=/var/log \
    --mount=type=tmpfs,target=/tmp \
    bash /ctx/component.sh

# ---- image version ----
ARG IMAGE_VERSION=dev

# ---- base family ----
ARG FAMILY=fedora

# ---- image identity ----
ARG IMAGE_ID="network"
ARG IMAGE_NAME="Network"
ARG IMAGE_REGISTRY=""

# ---- finalize ----
RUN --network=none --mount=type=bind,from=ctx,source=/generated/network/finalize.sh,target=/ctx/finalize.sh \
    --mount=type=bind,from=ctx,source=/generated/lib,target=/ctx/lib \
    --mount=type=bind,from=ctx,source=/components/core/tools,target=/ctx/components/core/tools \
    --mount=type=bind,from=tect,source=/tect,target=/ctx/tect \
    --mount=type=cache,target=/var/cache \
    --mount=type=cache,target=/var/log \
    --mount=type=tmpfs,target=/tmp \
    IMAGE_VERSION="${IMAGE_VERSION}" FAMILY="${FAMILY}" IMAGE_ID="${IMAGE_ID}" IMAGE_NAME="${IMAGE_NAME}" IMAGE_REGISTRY="${IMAGE_REGISTRY}" bash /ctx/finalize.sh


COPY --from=ctx /generated/plan.json /usr/share/tectonic/manifest.json

ARG BASE
ARG BASE_DECLARED=""
ARG TARGET=""
ARG SOURCE_COMMIT=""
ARG BUILD_BACKEND=""
ARG COMPONENT_HASHES=""
ARG ASSET_RESOLUTIONS=""
RUN --mount=type=bind,from=tect,source=/tect,target=/ctx/tect \
    BASE="${BASE}" BASE_DECLARED="${BASE_DECLARED}" TARGET="${TARGET}" \
    SOURCE_COMMIT="${SOURCE_COMMIT}" BUILD_BACKEND="${BUILD_BACKEND}" \
    COMPONENT_HASHES="${COMPONENT_HASHES}" \
    ASSET_RESOLUTIONS="${ASSET_RESOLUTIONS}" \
    IMAGE_ID="${IMAGE_ID}" IMAGE_VERSION="${IMAGE_VERSION}" /ctx/tect build-record

RUN --mount=type=tmpfs,target=/run --network=none bootc container lint

ARG FAMILY=fedora
ARG CONTRACT_FILES=""
RUN --mount=type=bind,from=tect,source=/tect,target=/ctx/tect \
    --mount=type=tmpfs,target=/tmp \
    --mount=type=tmpfs,target=/run \
    CONTRACT_FILES="${CONTRACT_FILES}" \
    FAMILY="${FAMILY}" /ctx/tect validate-image
