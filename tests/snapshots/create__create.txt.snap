==== modules/my-editor/module.kdl
schema-version 1

provides "editor"

packages "nano"
==== modules/plain/module.kdl
schema-version 1
==== example.image.kdl
schema-version 1

image {
    name "Example"
    url "https://github.com/someone/example"
    issues-url "https://github.com/someone/example/issues"

    base "quay.io/fedora/fedora-bootc:44" {
        family "fedora"
        provides "rechunking" "initramfs-generation" "luks-initramfs" "selinux-policy" "ssh" "bootc" "bootupctl" "podman" "crun"
        signed #false
    }

    layout {
        bootloader "grub2"
    }

    modules {
        module "my-editor"
        source "upstream" {
            module "fedora-family"
        }
    }
}
==== server.image.kdl
