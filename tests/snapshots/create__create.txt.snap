==== components/my-editor/manifest.kdl
schema-version 1

provides "editor"

packages "nano"
==== components/plain/manifest.kdl
schema-version 1
==== example.image.kdl
schema-version 1

image {
    name "Example"
    url "https://github.com/someone/example"
    issues-url "https://github.com/someone/example/issues"

    layout {
        bootloader "grub2"
    }

    base-image {
        fedora {
            version "44"
            signed #false
        }
    }
    my-editor
}
==== server.image.kdl
schema-version 1

