---
source: tests/golden/harness.rs
---
### Public keys
FROM ctx AS public-keys
COPY keys/public/ /public/

### Base Image
FROM ${BASE} AS rootfs

## Component layers

# ---- /opt build root ----
RUN mv /opt /opt.bak && mkdir /opt

# ---- /usr/local build root ----
RUN if [ -L /usr/local ]; then mv /usr/local /usr/local.bak && \
    mkdir -p /usr/local/bin /usr/local/etc /usr/local/games /usr/local/include \
    /usr/local/lib /usr/local/lib64 /usr/local/libexec /usr/local/share /usr/local/src; fi

# ---- kernel/signed-kernel ----
RUN --mount=type=bind,from=ctx,source=/components/kernel/signed-kernel,target=/ctx/components/kernel/signed-kernel \
    --mount=type=bind,from=ctx,source=/generated/lib,target=/ctx/lib \
    --mount=type=bind,from=ctx,source=/generated/signing/components/kernel/signed-kernel.sh,target=/ctx/component.sh \
    --mount=type=bind,from=public-keys,source=/public,target=/ctx/keys \
    --mount=type=bind,from=tect,source=/tect,target=/ctx/tect \
    --mount=type=cache,target=/var/cache \
    --mount=type=cache,target=/var/log \
    --mount=type=tmpfs,target=/tmp \
    --mount=type=secret,id=mok_privkey,target=/run/secrets/mok_privkey,required=false \
    KERNEL=${KERNEL} bash /ctx/component.sh

# ---- drivers/kvmfr ----
RUN --mount=type=bind,from=ctx,source=/components/drivers/kvmfr,target=/ctx/components/drivers/kvmfr \
    --mount=type=bind,from=ctx,source=/generated/lib,target=/ctx/lib \
    --mount=type=bind,from=ctx,source=/generated/signing/components/drivers/kvmfr.sh,target=/ctx/component.sh \
    --mount=type=bind,from=tect,source=/tect,target=/ctx/tect \
    --mount=type=cache,target=/var/cache \
    --mount=type=cache,target=/var/log \
    --mount=type=tmpfs,target=/tmp \
    --mount=type=secret,id=mok_privkey,target=/run/secrets/mok_privkey,required=false \
    bash /ctx/component.sh

# ---- image version ----
ARG IMAGE_VERSION=dev

# ---- base family ----
ARG FAMILY=fedora

# ---- claimed and refused rules ----
ARG SCAP_CLAIMED=
ARG SCAP_REFUSED=

# ---- image identity ----
ARG IMAGE_ID="signing"
ARG IMAGE_NAME="Signing"
ARG IMAGE_REGISTRY=""

# ---- finalize ----
RUN --mount=type=bind,from=ctx,source=/generated/signing/finalize.sh,target=/ctx/finalize.sh \
    --mount=type=bind,from=ctx,source=/generated/lib,target=/ctx/lib \
    --mount=type=bind,from=tect,source=/tect,target=/ctx/tect \
    --mount=type=cache,target=/var/cache \
    --mount=type=cache,target=/var/log \
    --mount=type=tmpfs,target=/tmp \
    IMAGE_VERSION="${IMAGE_VERSION}" FAMILY="${FAMILY}" SCAP_CLAIMED="${SCAP_CLAIMED}" SCAP_REFUSED="${SCAP_REFUSED}" IMAGE_ID="${IMAGE_ID}" IMAGE_NAME="${IMAGE_NAME}" IMAGE_REGISTRY="${IMAGE_REGISTRY}" bash /ctx/finalize.sh


COPY --from=ctx /generated/plan.json /usr/share/tectonic/manifest.json

ARG BASE
ARG BASE_DECLARED=""
ARG TARGET=""
ARG SOURCE_COMMIT=""
ARG BUILD_BACKEND=""
ARG COMPONENT_HASHES=""
ARG ASSET_RESOLUTIONS=""
RUN --mount=type=bind,from=tect,source=/tect,target=/ctx/tect \
    BASE="${BASE}" BASE_DECLARED="${BASE_DECLARED}" TARGET="${TARGET}" \
    SOURCE_COMMIT="${SOURCE_COMMIT}" BUILD_BACKEND="${BUILD_BACKEND}" \
    COMPONENT_HASHES="${COMPONENT_HASHES}" \
    ASSET_RESOLUTIONS="${ASSET_RESOLUTIONS}" \
    IMAGE_ID="${IMAGE_ID}" IMAGE_VERSION="${IMAGE_VERSION}" /ctx/tect build-record

RUN --mount=type=tmpfs,target=/run --network=none bootc container lint

ARG FAMILY=fedora
ARG CONTRACT_FILES=""
RUN --mount=type=bind,from=tect,source=/tect,target=/ctx/tect \
    --mount=type=tmpfs,target=/tmp \
    --mount=type=tmpfs,target=/run \
    CONTRACT_FILES="${CONTRACT_FILES}" \
    FAMILY="${FAMILY}" /ctx/tect validate-image
