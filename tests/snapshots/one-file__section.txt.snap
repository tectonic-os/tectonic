---
source: tests/golden/harness.rs
---
### Base Image
FROM ${BASE} AS rootfs

## Component layers

# ---- /opt build root ----
RUN mv /opt /opt.bak && mkdir /opt

# ---- /usr/local build root ----
RUN if [ -L /usr/local ]; then mv /usr/local /usr/local.bak && \
    mkdir -p /usr/local/bin /usr/local/etc /usr/local/games /usr/local/include \
    /usr/local/lib /usr/local/lib64 /usr/local/libexec /usr/local/share /usr/local/src; fi

# ---- fedora-family ----
RUN --mount=type=bind,from=ctx,source=/components/fedora-family,target=/ctx/components/fedora-family \
    --mount=type=bind,from=ctx,source=/generated/lib,target=/ctx/lib,rw \
    --mount=type=bind,from=ctx,source=/components/fedora-family/lib/family.sh,target=/ctx/lib/family.sh \
    --mount=type=bind,from=ctx,source=/generated/alpha/components/fedora-family.sh,target=/ctx/component.sh \
    --mount=type=bind,from=tect,source=/tect,target=/ctx/tect \
    --mount=type=cache,target=/var/cache \
    --mount=type=cache,target=/var/log \
    --mount=type=tmpfs,target=/tmp \
    bash /ctx/component.sh

# ---- core/hello ----
RUN --mount=type=bind,from=ctx,source=/components/core/hello,target=/ctx/components/core/hello \
    --mount=type=bind,from=ctx,source=/generated/lib,target=/ctx/lib,rw \
    --mount=type=bind,from=ctx,source=/components/fedora-family/lib/family.sh,target=/ctx/lib/family.sh \
    --mount=type=bind,from=ctx,source=/generated/alpha/components/core/hello.sh,target=/ctx/component.sh \
    --mount=type=bind,from=tect,source=/tect,target=/ctx/tect \
    --mount=type=cache,target=/var/cache \
    --mount=type=cache,target=/var/log \
    --mount=type=tmpfs,target=/tmp \
    bash /ctx/component.sh

# ---- flavour gate ----
ARG FLAVOUR

# ---- image version ----
ARG IMAGE_VERSION=dev

# ---- base family ----
ARG FAMILY

# ---- declared conformance ----
ARG CONFORMS=

# ---- claimed and refused rules ----
ARG SCAP_CONTENT=
ARG SCAP_CLAIMED=
ARG SCAP_REFUSED=

# ---- image identity ----
ARG IMAGE_ID="alpha"
ARG IMAGE_NAME="Alpha"
ARG IMAGE_REGISTRY=""

# ---- finalize ----
RUN --mount=type=bind,from=ctx,source=/generated/alpha/finalize.sh,target=/ctx/finalize.sh \
    --mount=type=bind,from=ctx,source=/generated/lib,target=/ctx/lib \
    --mount=type=bind,from=tect,source=/tect,target=/ctx/tect \
    --mount=type=cache,target=/var/cache \
    --mount=type=cache,target=/var/log \
    --mount=type=tmpfs,target=/tmp \
    FLAVOUR=${FLAVOUR} IMAGE_VERSION="${IMAGE_VERSION}" \
    CONFORMS="${CONFORMS}" FAMILY="${FAMILY}" \
    SCAP_CONTENT="${SCAP_CONTENT}" SCAP_CLAIMED="${SCAP_CLAIMED}" \
    SCAP_REFUSED="${SCAP_REFUSED}" \
    IMAGE_ID="${IMAGE_ID}" IMAGE_NAME="${IMAGE_NAME}" IMAGE_REGISTRY="${IMAGE_REGISTRY}" bash /ctx/finalize.sh

# verbatim from components/core/hello/Containerfile.inc:
# The lineage stage has ended by here, so it can be bound from a stage of its
# own. Whatever a tail fragment opens last is the final image.
FROM rootfs AS greeting
RUN --mount=type=bind,from=rootfs,source=/,target=/rootfs,rw \
    cp /rootfs/etc/os-release /os-release

FROM rootfs
COPY --from=greeting /os-release /usr/share/hello-os-release
