==== the lock
module "browser" {
    library "upstream"
    path "browser"
    content "a34ddf304dea07b9b7483d3fdad6b23af36f7709b2a8400e360624888b91d44f"
    track
}

module "flatpak" {
    library "upstream"
    path "flatpak"
    content "458f87fc5f85d09877f75b41f4be3613cf7e38c9a78d7e3e4ec365a2e6aab6ce"
    track
}
