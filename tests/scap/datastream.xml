<?xml version="1.0" encoding="UTF-8"?>
<ds:data-stream-collection xmlns:ds="http://scap.nist.gov/schema/scap/source/1.2">
  <ds:component id="scap_org.open-scap_comp_ssg-fedora-xccdf.xml">
    <Benchmark xmlns="http://checklists.nist.gov/xccdf/1.2" id="xccdf_org.ssgproject.content_benchmark_FEDORA">
      <!-- A comment, and a > inside an attribute value, which the scanner has to walk past. -->
      <Profile id="xccdf_org.ssgproject.content_profile_cis">
        <title>CIS Benchmark</title>
        <select idref="xccdf_org.ssgproject.content_rule_package_aide_installed" selected="true"/>
        <select idref="xccdf_org.ssgproject.content_rule_sshd_disable_root_login" selected="true"/>
        <select idref="xccdf_org.ssgproject.content_rule_audit_rules_login_events" selected="true"/>
        <select idref="xccdf_org.ssgproject.content_group_nothing" selected="true"/>
      </Profile>
      <Profile id="xccdf_org.ssgproject.content_profile_cis_server_l2" extends="xccdf_org.ssgproject.content_profile_cis">
        <title>CIS Level 2 Server</title>
        <select idref="xccdf_org.ssgproject.content_rule_no_empty_passwords" selected="true"/>
        <select idref="xccdf_org.ssgproject.content_rule_package_aide_installed" selected="false"/>
      </Profile>
      <Rule id="xccdf_org.ssgproject.content_rule_package_aide_installed" severity="medium">
        <title>Install AIDE</title>
        <description>Read this rather than the &gt; below.</description>
        <reference href="https://www.cisecurity.org/">1.1.1.1</reference>
      </Rule>
      <Rule id="xccdf_org.ssgproject.content_rule_sshd_disable_root_login">
        <title>Disable SSH Root Login</title>
        <description>Root login over SSH is what the rule closes.</description>
        <reference href="https://www.cisecurity.org/">5.2.20</reference>
        <ident system="https://public.cyber.mil/stigs/">RHEL-09-232010</ident>
      </Rule>
      <Rule id="xccdf_org.ssgproject.content_rule_no_empty_passwords">
        <title>Prevent Login to Accounts With Empty Password</title>
        <reference href="https://www.cisecurity.org/">5.5.2</reference>
      </Rule>
      <Rule id="xccdf_org.ssgproject.content_rule_audit_rules_login_events">
        <title>Record Attempts to Alter Logon and Logout Events</title>
        <reference href="https://www.cisecurity.org/">4.1.3.1</reference>
      </Rule>
    </Benchmark>
  </ds:component>
</ds:data-stream-collection>
