// No row here carries a digest, which is a decision rather than an omission.
// Pinning in this file would make every digest roll a tool release, and a row
// that goes stale between releases is one nobody can fix without waiting for
// the next one — worse on a base whose registry retires the old digest, where
// a stale catalog pin stops resolving at all. So the catalog offers the tag,
// and the digest belongs in the image file built on it: the repository that
// takes the risk takes the decision, Renovate bumps it there like any other
// pin, and `tect build` records the digest it actually resolved either way.

base "quay.io/fedora/fedora-bootc:44" {
    about "Fedora 44, nothing above the base system"
    family "fedora"
    provides "rechunking" "initramfs-generation" "selinux-policy"
}

// Universal Blue Images
base "ghcr.io/ublue-os/bazzite:stable" {
    about "KDE, gaming and hardware support over kinoite-main"
    family "fedora"
    provides "rechunking" "flatpak"
    provides-file "/usr/bin/flatpak"
    signed #true
}

base "ghcr.io/ublue-os/aurora:stable" {
    about "KDE developer workstation over kinoite-main"
    family "fedora"
    provides "rechunking" "flatpak"
    provides-file "/usr/bin/flatpak"
    signed #true
}

base "ghcr.io/ublue-os/bluefin:stable" {
    about "GNOME developer workstation over silverblue-main"
    family "fedora"
    provides "rechunking" "flatpak"
    provides-file "/usr/bin/flatpak"
    signed #true
}

base "ghcr.io/ublue-os/kinoite-main:44" {
    about "Fedora Kinoite with the ublue additions, what bazzite builds on"
    family "fedora"
    provides "rechunking" "flatpak"
    provides-file "/usr/bin/flatpak"
    signed #true
}

// Debian, which is not a bootc image: it carries no kernel, no dracut, no
// bootc and no AppArmor userspace, so a module set has to make it bootable
// before anything else in an image on it means anything.
//
// forky and not trixie, measured 2026-09-01. `--composefs-backend` is what
// reaches a bootloader on a base with no `bootupd`, Debian packages no
// `bootupd`, and every bootc carrying that flag needs libostree >= 2025.3.
// trixie ships 2025.2, with nothing newer in backports or proposed-updates.
// forky carries 2026.4 and becomes Debian 14.
base "docker.io/library/debian:forky" {
    about "Debian 14, which a module set has to turn into a bootc image"
    family "debian"
    requires "bootc-base"
    signed #false
}

// Ubuntu, measured 2026-09-03 against the gates that chose forky over trixie.
// It clears all of them and one forky cannot: `VERSION_ID` is present, which
// `bootc-image-builder` refuses to write a manifest without. An LTS rather
// than a rolling testing suite, and its package database is real, so the audit
// argument that condemns every published deb bootc base does not condemn this.
//
// One thing it needs that Debian does not: `ubuntu:*` ships
// `/etc/dpkg/dpkg.cfg.d/excludes`, which path-excludes man pages, most of
// `/usr/share/doc` and the locale catalogues from every package any derived
// image ever unpacks. `deb-bootc-base` removes it and reinstalls every
// recorded package, because deleting the file restores nothing already
// stripped. See §8 of cannot-claim.md: that is a repair, not an absence.
base "docker.io/library/ubuntu:26.04" {
    about "Ubuntu 26.04 LTS, which a module set has to turn into a bootc image"
    family "ubuntu"
    requires "bootc-base"
    signed #false
}
