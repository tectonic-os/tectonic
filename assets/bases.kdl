// Every row carries `signed`, measured 2026-09-11 unless it says otherwise:
// `#true` is a published cosign signature, keyless or keyed, and
// `base-sig-probe` can only correct a line that is there.
//
// No row here carries a digest: pinning in this file would make every digest
// roll a tool release, and a stale pin stops resolving once a registry retires
// the digest. The catalog offers the tag, the digest belongs in the image file
// built on it, and `tect build` records what it resolved either way.

// `bootloader` is what an image on the row can install, its default first. The
// deb rows' pair is `deb-family/bootc-base`'s signed GRUB and its systemd-boot.

// Under-claiming refuses a module and says why; over-claiming is silent —
// `resolve::graph::suppress` drops a module the base covers entirely with no
// diagnostic — so nothing goes in `provides` that has not been run against the
// image, and `validate-image` checks every name on the finished one.

// Where a capability's presence is read, for a name found neither at
// `/usr/bin/<name>` nor at `/usr/sbin/<name>`; a row with no path is one
// nothing witnesses. The rows at a default path are the names `base-sig-probe`
// looks for on a base that does not claim them yet.
capability "ssh" "/usr/sbin/sshd"
capability "initramfs-generation" "/usr/bin/dracut"
capability "selinux-policy" "/usr/sbin/semodule"
capability "flatpak" "/usr/bin/flatpak"
capability "bootc" "/usr/bin/bootc"
capability "bootupctl" "/usr/bin/bootupctl"
capability "podman" "/usr/bin/podman"
capability "crun" "/usr/bin/crun"
capability "rechunking"

base "quay.io/fedora/fedora-bootc:44" {
    about "Fedora 44, nothing above the base system"
    family "fedora"
    provides "rechunking" "initramfs-generation" "selinux-policy" "ssh" "bootc" "bootupctl" \
        "podman" "crun"
    scap-content "ssg-fedora-ds.xml"
    signed #false
    bootloader "grub2"
}

// CentOS Stream 10, the EL base. `family "rhel"` is EL's archive: it installs
// like Fedora and its package names differ, as Debian's and Ubuntu's do. Its
// kernel carries no btrfs.
//
// The content is the reason to build on it. `ssg-cs10-ds.xml` carries 18
// profiles to Fedora's 8, including `stig` at 509 rules and `cis_server_l1` at
// 323, and it is authored for the OS being measured. Measured 2026-09-09
// against the image: every path below is present and bootc is 1.16.6.
base "quay.io/centos-bootc/centos-bootc:stream10" {
    about "CentOS Stream 10, the EL base a stated claim can be measured against"
    family "rhel"
    provides "rechunking" "initramfs-generation" "selinux-policy" "ssh" "bootc" "bootupctl" \
        "podman" "crun"
    scap-content "ssg-cs10-ds.xml"
    signed #true
    bootloader "grub2"
}

// RHEL 10, the supported EL base, and the only row here behind a login:
// `podman login registry.redhat.io` with a Red Hat account, individual
// subscriptions included. Measured 2026-09-09 against the image: RHEL 10.2,
// bootc 1.16.4, and every path below present.
//
// `scap-security-guide` is not in the container's repos without entitlement,
// so a build running the remediation step needs the host's entitlement
// certificates. CentOS Stream 10 carries the same content unentitled and is
// the row to develop against.
base "registry.redhat.io/rhel10/rhel-bootc:latest" {
    about "RHEL 10, the supported EL base, behind a Red Hat login"
    family "rhel"
    provides "rechunking" "initramfs-generation" "selinux-policy" "ssh" "bootc" "bootupctl" \
        "podman" "crun"
    scap-content "ssg-rhel10-ds.xml"
    // Unmeasured: `registry.redhat.io` answers no signature read without a
    // login. `#false` is the under-claim, and a line `base-sig-probe` can
    // correct where a missing one is not.
    signed #false
    bootloader "grub2"
}

// AlmaLinux 10, the RHEL rebuild, with the content RHEL keeps behind
// entitlement: `ssg-almalinux10-ds.xml` comes out of AlmaLinux's own
// ComplianceAsCode fork and its repos carry SSG 0.1.81 unentitled. Measured
// 2026-09-11 against the image: 10.2, bootc 1.16.4, rpm-ostree 2026.1 with
// `compose build-chunked-oci`, and every path below present.
//
// Two things it does that the other two EL rows do not: `crb` is enabled out
// of the box, and its kernel ships btrfs with `btrfs-progs` in the repos.
base "quay.io/almalinuxorg/almalinux-bootc:10" {
    about "AlmaLinux 10, the RHEL rebuild, whose benchmark needs no entitlement"
    family "rhel"
    provides "rechunking" "initramfs-generation" "selinux-policy" "ssh" "bootc" "bootupctl" \
        "podman" "crun"
    scap-content "ssg-almalinux10-ds.xml"
    signed #true
    bootloader "grub2"
}

// Universal Blue Images
base "ghcr.io/ublue-os/bazzite:stable" {
    about "KDE, gaming and hardware support over kinoite-main"
    family "fedora"
    provides "rechunking" "flatpak"
    signed #true
    scap-content "ssg-fedora-ds.xml"
    bootloader "grub2"
}

base "ghcr.io/ublue-os/aurora:stable" {
    about "KDE developer workstation over kinoite-main"
    family "fedora"
    provides "rechunking" "flatpak"
    signed #true
    scap-content "ssg-fedora-ds.xml"
    bootloader "grub2"
}

base "ghcr.io/ublue-os/bluefin:stable" {
    about "GNOME developer workstation over silverblue-main"
    family "fedora"
    provides "rechunking" "flatpak"
    signed #true
    scap-content "ssg-fedora-ds.xml"
    bootloader "grub2"
}

base "ghcr.io/ublue-os/kinoite-main:44" {
    about "Fedora Kinoite with the ublue additions, what bazzite builds on"
    family "fedora"
    provides "rechunking" "flatpak"
    signed #true
    scap-content "ssg-fedora-ds.xml"
    bootloader "grub2"
}

// Rocky, which is not a bootc image and is the only EL row that is not: Rocky
// publishes none. What its plain container does have is a working rpm database
// and every part in its own repos — `bootc`, `bootupd`, `ostree`, `composefs`,
// the kernel and the signed shim — so `rhel-family/bootc-base` installs rather
// than compiles, where the deb set builds bootc and bootupd from pinned
// source. Measured 2026-09-11: no cosign signature, and 137 of the container's
// 138 packages carry a Rocky header signature.
//
// `ssg-rl10-ds.xml` is Rocky's own datastream, beside the `ssg-rhel10-ds.xml`
// its `scap-security-guide` also ships. Neither is measured here yet.
base "quay.io/rockylinux/rockylinux:10" {
    about "Rocky Linux 10, which a module set has to turn into a bootc image"
    family "rhel"
    requires "bootc-base"
    signed #false
    scap-content "ssg-rl10-ds.xml"
    bootloader "grub2"
}

// Debian, which is not a bootc image: it carries no kernel, no dracut, no
// bootc and no AppArmor userspace, so a module set has to make it bootable
// before anything else in an image on it means anything.
//
// forky, because `--composefs-backend` is what reaches a bootloader on a base
// with no `bootupd`, Debian packages none, and every bootc carrying that flag
// needs libostree >= 2025.3. trixie ships 2025.2; forky carries 2026.4.
base "docker.io/library/debian:forky" {
    about "Debian 14, which a module set has to turn into a bootc image"
    family "debian"
    requires "bootc-base"
    signed #false
    bootloader "grub2" "systemd"
}

// Ubuntu. It clears the gates that chose forky over trixie and one forky
// cannot: `VERSION_ID` is present, which `bootc-image-builder` refuses to write
// a manifest without. An LTS, and its package database is real.
//
// `ubuntu:*` ships `/etc/dpkg/dpkg.cfg.d/excludes`, which path-excludes man
// pages, most of `/usr/share/doc` and the locale catalogues from every package
// any derived image unpacks. `deb-bootc-base` removes it and reinstalls every
// recorded package, since deleting the file restores nothing already stripped.
base "docker.io/library/ubuntu:26.04" {
    about "Ubuntu 26.04 LTS, which a module set has to turn into a bootc image"
    family "ubuntu"
    requires "bootc-base"
    signed #false
    bootloader "grub2" "systemd"
}
