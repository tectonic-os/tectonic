// No row here carries a digest: pinning in this file would make every digest
// roll a tool release, and a stale pin stops resolving once a registry retires
// the digest. The catalog offers the tag, the digest belongs in the image file
// built on it, and `tect build` records what it resolved either way.

// Under-claiming refuses a module and says why; over-claiming is silent —
// `resolve::graph::suppress` drops a module the base covers entirely with no
// diagnostic — so nothing goes in this node that has not been run against the
// image.
//
// The five paths are the ones the collection contracts on: `login-access`
// requires the first, and `deb-family/bootc-base` and
// `deb-family/container-runtime` provide the other four, which is what makes a
// module written against them family-neutral. `/usr/bin/dracut` and
// `/usr/sbin/semodule` are witnesses for claims this row already makes and are
// left out. `rechunking` has no witness path and stays hand-declared.
base "quay.io/fedora/fedora-bootc:44" {
    about "Fedora 44, nothing above the base system"
    family "fedora"
    provides "rechunking" "initramfs-generation" "selinux-policy"
    provides-file "/usr/sbin/sshd" "/usr/bin/bootc" "/usr/bin/bootupctl" \
        "/usr/bin/podman" "/usr/bin/crun"
    scap-content "ssg-fedora-ds.xml"
}

// CentOS Stream 10, the EL base. `family "fedora"` because every family-gated
// behaviour matches: dnf, rpm, SELinux, and `bootupctl` for the recipe's
// bootupd grub2 arm. The one thing that diverges is the benchmark, which is
// why `scap-content` exists rather than a third family.
//
// The content is the reason to build on it. `ssg-cs10-ds.xml` carries 18
// profiles to Fedora's 8, including `stig` at 509 rules and `cis_server_l1` at
// 323, and it is authored for the OS being measured. Measured 2026-09-09
// against the image: every path below is present and bootc is 1.16.6.
base "quay.io/centos-bootc/centos-bootc:stream10" {
    about "CentOS Stream 10, the EL base a stated claim can be measured against"
    family "fedora"
    provides "rechunking" "initramfs-generation" "selinux-policy"
    provides-file "/usr/sbin/sshd" "/usr/bin/bootc" "/usr/bin/bootupctl" \
        "/usr/bin/podman" "/usr/bin/crun"
    scap-content "ssg-cs10-ds.xml"
}

// RHEL 10, the supported EL base, and the only row here behind a login:
// `podman login registry.redhat.io` with a Red Hat account, individual
// subscriptions included. Measured 2026-09-09 against the image: RHEL 10.2,
// bootc 1.16.4, and every path below present.
//
// `scap-security-guide` is not in the container's repos without entitlement,
// so a build running the remediation step needs the host's entitlement
// certificates. CentOS Stream 10 carries the same content unentitled and is
// the row to develop against.
base "registry.redhat.io/rhel10/rhel-bootc:latest" {
    about "RHEL 10, the supported EL base, behind a Red Hat login"
    family "fedora"
    provides "rechunking" "initramfs-generation" "selinux-policy"
    provides-file "/usr/sbin/sshd" "/usr/bin/bootc" "/usr/bin/bootupctl" \
        "/usr/bin/podman" "/usr/bin/crun"
    scap-content "ssg-rhel10-ds.xml"
}

// Universal Blue Images
base "ghcr.io/ublue-os/bazzite:stable" {
    about "KDE, gaming and hardware support over kinoite-main"
    family "fedora"
    provides "rechunking" "flatpak"
    provides-file "/usr/bin/flatpak"
    signed #true
    scap-content "ssg-fedora-ds.xml"
}

base "ghcr.io/ublue-os/aurora:stable" {
    about "KDE developer workstation over kinoite-main"
    family "fedora"
    provides "rechunking" "flatpak"
    provides-file "/usr/bin/flatpak"
    signed #true
    scap-content "ssg-fedora-ds.xml"
}

base "ghcr.io/ublue-os/bluefin:stable" {
    about "GNOME developer workstation over silverblue-main"
    family "fedora"
    provides "rechunking" "flatpak"
    provides-file "/usr/bin/flatpak"
    signed #true
    scap-content "ssg-fedora-ds.xml"
}

base "ghcr.io/ublue-os/kinoite-main:44" {
    about "Fedora Kinoite with the ublue additions, what bazzite builds on"
    family "fedora"
    provides "rechunking" "flatpak"
    provides-file "/usr/bin/flatpak"
    signed #true
    scap-content "ssg-fedora-ds.xml"
}

// Debian, which is not a bootc image: it carries no kernel, no dracut, no
// bootc and no AppArmor userspace, so a module set has to make it bootable
// before anything else in an image on it means anything.
//
// forky, because `--composefs-backend` is what reaches a bootloader on a base
// with no `bootupd`, Debian packages none, and every bootc carrying that flag
// needs libostree >= 2025.3. trixie ships 2025.2; forky carries 2026.4.
base "docker.io/library/debian:forky" {
    about "Debian 14, which a module set has to turn into a bootc image"
    family "debian"
    requires "bootc-base"
    signed #false
}

// Ubuntu. It clears the gates that chose forky over trixie and one forky
// cannot: `VERSION_ID` is present, which `bootc-image-builder` refuses to write
// a manifest without. An LTS, and its package database is real.
//
// `ubuntu:*` ships `/etc/dpkg/dpkg.cfg.d/excludes`, which path-excludes man
// pages, most of `/usr/share/doc` and the locale catalogues from every package
// any derived image unpacks. `deb-bootc-base` removes it and reinstalls every
// recorded package, since deleting the file restores nothing already stripped.
base "docker.io/library/ubuntu:26.04" {
    about "Ubuntu 26.04 LTS, which a module set has to turn into a bootc image"
    family "ubuntu"
    requires "bootc-base"
    signed #false
}
