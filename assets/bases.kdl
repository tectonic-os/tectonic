base "quay.io/fedora/fedora-bootc:44" {
    about "Fedora 44, nothing above the base system"
    family "fedora"
    provides "rechunking" "initramfs-generation" "selinux-policy"
}

// Universal Blue Images
base "ghcr.io/ublue-os/bazzite:stable" {
    about "KDE, gaming and hardware support over kinoite-main"
    family "fedora"
    provides "rechunking" "flatpak"
    provides-file "/usr/bin/flatpak"
    signed #true
}

base "ghcr.io/ublue-os/aurora:stable" {
    about "KDE developer workstation over kinoite-main"
    family "fedora"
    provides "rechunking" "flatpak"
    provides-file "/usr/bin/flatpak"
    signed #true
}

base "ghcr.io/ublue-os/bluefin:stable" {
    about "GNOME developer workstation over silverblue-main"
    family "fedora"
    provides "rechunking" "flatpak"
    provides-file "/usr/bin/flatpak"
    signed #true
}

base "ghcr.io/ublue-os/kinoite-main:44" {
    about "Fedora Kinoite with the ublue additions, what bazzite builds on"
    family "fedora"
    provides "rechunking" "flatpak"
    provides-file "/usr/bin/flatpak"
    signed #true
}

// Bootcrew images - bootc implemented for non-RHEL based images. Neither ships
// rpm-ostree, and there are no rpm packages to chunk by, so neither rechunks.
base "ghcr.io/bootcrew/debian-bootc:latest" {
    about "Experimental Debian bootc base from Bootcrew"
    family "debian"
    provides "initramfs-generation" "apparmor-policy"
    signed #true
}

base "ghcr.io/bootcrew/ubuntu-bootc:latest" {
    about "Experimental Ubuntu bootc base from Bootcrew"
    family "ubuntu"
    provides "initramfs-generation"
    signed #true
}

base "ghcr.io/jmarrero/ubuntu-bootc:latest" {
    about "Experimental Ubuntu 26.04 bootc base with cloud-init"
    family "ubuntu"
    provides "initramfs-generation"
    signed #false
}

// A container base, not a bootc image: it carries no kernel, no dracut, no
// bootc and no AppArmor userspace, so a module set has to make it bootable
// before anything else in an image on it means anything.
base "docker.io/library/debian:trixie" {
    about "Debian 13, which a module set has to turn into a bootc image"
    family "debian"
    requires "bootc-base"
    signed #false
}
