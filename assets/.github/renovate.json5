{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
  ],

  "rebaseWhen": "never",

  // Early enough that the PR build and automerge finish before the 12:30 UTC
  // image build.
  "timezone": "Etc/UTC",
  "schedule": ["before 6am"],

  "packageRules": [
    {
      "matchPackageNames": ["*"],
      "groupName": "scheduled updates",
      "automerge": true,
    },
    {
      "enabled": false,
      "matchUpdateTypes": ["digest", "pinDigest", "pin"],
      "matchDepTypes": ["container"],
      "matchFileNames": [".github/workflows/**.yaml", ".github/workflows/**.yml"],
    },
    {
      // quay.io/fedora prunes untagged manifests within days, so a pinned
      // digest 404s before the next bump lands. Track the tag.
      "matchPackageNames": ["quay.io/fedora/fedora-bootc"],
      "pinDigests": false,
    },
  ],

  // A generated Containerfile is named for its image, which the dockerfile
  // manager does not recognise, and its FROM has to bump with the declaration
  // below.
  "dockerfile": {
    "managerFilePatterns": ["/^generated/[^/.]+$/"],
  },

  // Each of these matches a `renovate` node and the tracked line directly
  // below it. `scripts/lint.sh` fails a pin these cannot match.
  "customManagers": [
    {
      "customType": "regex",
      // The tag carries the version, so the leading v comes back off.
      "description": "The pinned build tool release",
      "managerFilePatterns": ["/^scripts/tect\\.sh$/"],
      "extractVersionTemplate": "^v(?<version>.+)$",
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s*\\nversion=\"(?<currentValue>[^\"]+)\"",
      ],
    },
    {
      "customType": "regex",
      // Every root .kdl but repo.kdl is an image declaring its own base, so
      // the pattern is the layout rather than one file name.
      "description": "Base image reference in an image file",
      "managerFilePatterns": ["/^[^/]+\\.kdl$/"],
      "datasourceTemplate": "docker",
      "matchStrings": [
        "base \"(?<depName>[^\":]+):(?<currentValue>[^\"]+)\"",
      ],
    },
    {
      "customType": "regex",
      // RE2 has no negative lookahead, so the leading-lowercase rule is how
      // an underscore-prefixed module directory is excluded.
      "description": "Version-tagged asset pins in module.kdl",
      "managerFilePatterns": ["/^modules/([a-z][^/]*/)?[a-z][^/]*/module\\.kdl$/"],
      "matchStrings": [
        "renovate datasource=\"(?<datasource>github-releases|github-tags)\" depName=\"(?<depName>[^\"]+)\"(?: extractVersion=\"(?<extractVersion>[^\"]+)\")?\\s*\\n\\s*version \"(?<currentValue>[^\"]+)\"",
      ],
    },
    {
      "customType": "regex",
      "description": "Commit-pinned asset pins in module.kdl",
      "managerFilePatterns": ["/^modules/([a-z][^/]*/)?[a-z][^/]*/module\\.kdl$/"],
      "matchStrings": [
        "renovate datasource=\"(?<datasource>git-refs)\" depName=\"(?<depName>[^\"]+)\"\\s*\\n\\s*version \"(?<currentDigest>[^\"]+)\"",
      ],
      // The regex manager requires a currentValue even for a digest-only pin.
      "currentValueTemplate": "master",
    },
    {
      "customType": "regex",
      // Tags only: a module is published as a per-module tag, and the parser
      // rejects git-refs here.
      "description": "Out-of-tree module pins in an image file",
      "managerFilePatterns": ["/^[^/]+\\.kdl$/"],
      "matchStrings": [
        "renovate datasource=\"(?<datasource>github-releases|github-tags)\" depName=\"(?<depName>[^\"]+)\"(?: extractVersion=\"(?<extractVersion>[^\"]+)\")?\\s*\\n\\s*ref \"(?<currentValue>[^\"]+)\"",
      ],
    },
  ],
}
