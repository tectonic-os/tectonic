{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
  ],

  "rebaseWhen": "never",

  // `tect generate` writes the workflows and `tect verify` byte-compares
  // them, so a bump inside one is reverted by the next regeneration.
  "ignorePaths": [".github/workflows/**"],

  // Early enough that the PR build and automerge finish before the 12:30 UTC
  // image build.
  "timezone": "Etc/UTC",
  "schedule": ["before 6am"],

  "packageRules": [
    {
      "matchPackageNames": ["*"],
      "groupName": "scheduled updates",
      "automerge": true,
    },
    {
      // quay.io/fedora prunes untagged manifests within days, so a pinned
      // digest 404s before the next bump lands. Track the tag.
      "matchPackageNames": ["quay.io/fedora/fedora-bootc"],
      "pinDigests": false,
    },
  ],

  // A generated Containerfile sits under its image's own directory, which the
  // dockerfile manager does not recognise, and its FROM has to bump with the
  // declaration below.
  "dockerfile": {
    "managerFilePatterns": ["/^generated/[^/]+/Containerfile$/"],
  },

  // Each of these matches a `renovate` node and the tracked line directly
  // below it. `scripts/lint.sh` fails a pin these cannot match.
  "customManagers": [
    {
      "customType": "regex",
      // The tag carries the version, so the leading v comes back off.
      "description": "The pinned build tool release",
      "managerFilePatterns": ["/^repo\\.kdl$/"],
      "extractVersionTemplate": "^v(?<version>.+)$",
      "matchStrings": [
        "// renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s*\\ntect-version \"(?<currentValue>[^\"]+)\"",
      ],
    },
    {
      "customType": "regex",
      // Every root .kdl but repo.kdl is an image declaring its own base, so
      // the pattern is the layout rather than one file name.
      "description": "Base image reference in an image file",
      "managerFilePatterns": ["/^[^/]+\\.kdl$/"],
      "datasourceTemplate": "docker",
      "matchStrings": [
        "base \"(?<depName>[^\":]+):(?<currentValue>[^\"]+)\"",
      ],
    },
    {
      "customType": "regex",
      // One spelling for every pin, so one manager covers an asset, an
      // out-of-tree module and a collection. RE2 has no negative lookahead, so
      // the leading-lowercase rule is how an underscore-prefixed module
      // directory is excluded.
      "description": "Version-tagged pins",
      "managerFilePatterns": [
        "/^modules/([a-z][^/]*/)?[a-z][^/]*/module\\.kdl$/",
        "/^[^/]+\\.kdl$/",
      ],
      "matchStrings": [
        "renovate datasource=\"(?<datasource>github-releases|github-tags)\" depName=\"(?<depName>[^\"]+)\"(?: extractVersion=\"(?<extractVersion>[^\"]+)\")?\\s*\\n\\s*version \"(?<currentValue>[^\"]+)\"",
      ],
    },
    {
      "customType": "regex",
      "description": "Commit-pinned asset pins in module.kdl",
      "managerFilePatterns": ["/^modules/([a-z][^/]*/)?[a-z][^/]*/module\\.kdl$/"],
      "matchStrings": [
        "renovate datasource=\"(?<datasource>git-refs)\" depName=\"(?<depName>[^\"]+)\"\\s*\\n\\s*version \"(?<currentDigest>[^\"]+)\"",
      ],
      // The regex manager requires a currentValue even for a digest-only pin.
      "currentValueTemplate": "master",
    },
  ],
}
